# ==============================================================================
# 💻 1. 本地开发配置模版 (.env.example -> 复制生成 .dev.vars)
#
# 使用指南：
# 1. 运行 npm run setup:local 会自动基于本文件生成 .dev.vars，并自动补齐安全随机密钥。
# 2. 本地开发零配置直接开箱体验：npm run dev 即可访问 http://127.0.0.1:4317/
# 3. 本文件已加入 .gitignore，本地密钥绝不会提交到 Git。
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 1. 会话安全与本地超级管理员权限
# ------------------------------------------------------------------------------

# 【自动生成】Better Auth 用户会话 Cookie 签名加密密钥
# 说明：运行 npm run setup:local 时系统会自动生成 48 位随机字符串填入，无需手动填写。
BETTER_AUTH_SECRET=

# 【自动生成】离线充值卡密与兑换码的高强度 AES-256-GCM 加密密钥（64 位十六进制字符）
# 说明：运行 npm run setup:local 时系统会自动生成 64 位 Hex 密钥填入。
REDEMPTION_ENCRYPTION_KEY=

# 【选填】本地管理员 User ID（授权访问本地 http://127.0.0.1:4317/admin 超管大盘）
# 推荐操作：本地启动后，在前台注册账号（如 test@example.com），进入个人中心 /account 复制 User ID 填入此处即可。
ADMIN_USER_IDS=


# ------------------------------------------------------------------------------
# 📧 2. 事务性邮件服务 (Resend，本地测试按需选填)
# ------------------------------------------------------------------------------

# 【选填】Resend 邮件发送 API Key（以 re_ 开头）
# 说明：留空则本地注册与找回密码安全降级，不会真正往外发信；填入后可测试真实邮件投递。
RESEND_API_KEY=

# 【选填】发信人邮箱地址（必须是已在 Resend 控制台 Domains 页面验证通过的域名）
# 示例：support@yourdomain.com
EMAIL_FROM=

# 【选填】Google OAuth 2.0 一键快捷登录凭据
# 本地重定向回调 URI：http://127.0.0.1:4317/api/auth/callback/google
# 说明：留空则前台自动隐藏 Google 登录按钮，仅保留常规邮箱验证码登录。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ------------------------------------------------------------------------------
# 💳 3. 商业支付集成（本地联调测试按需选填）
# ------------------------------------------------------------------------------

# 【选填】本地默认启用的支付通道
# 可选值：pancake (默认，Waffo Pancake 聚合支付) / stripe / creem / paypal
PAYMENT_PROVIDER=pancake

# --- 渠道 A：Waffo Pancake 聚合支付测试沙箱凭据 ---
# 获取方式：登录 https://waffo.ai 控制台
PANCAKE_MERCHANT_ID=
# 商户 RSA 签名私钥（PEM 格式，支持单行内用 \n 转义真实换行，服务端自动恢复，绝不外发）
PANCAKE_PRIVATE_KEY=
# 平台 Webhook 回调验签公钥（PEM 格式，在 Pancake 后台 Webhook 页面复制）
PANCAKE_WEBHOOK_PUBLIC_KEY=
# Pancake 店铺 ID
PANCAKE_STORE_ID=
# 可选覆盖端点（默认直连官方: https://api.waffo.ai，留空即可）
# PANCAKE_BASE_URL=https://api.waffo.ai

# --- 渠道 B：Stripe 测试环境 (使用沙箱测试公私钥) ---
# 获取方式：登录 https://dashboard.stripe.com 开启 "Test mode" 获取 sk_test_...
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# 可选覆盖端点（默认直连官方: https://api.stripe.com，留空即可）
# STRIPE_BASE_URL=https://api.stripe.com

# --- 渠道 C：Creem 测试环境 ---
# 获取方式：登录 https://creem.io 后台获取沙箱测试 Key
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# 可选覆盖端点（测试环境默认直连: https://test-api.creem.io，留空即可）
# CREEM_BASE_URL=https://test-api.creem.io

# --- 渠道 D：PayPal 沙箱测试环境 ---
# 获取方式：登录 https://developer.paypal.com 创建 Sandbox REST App
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# 可选覆盖端点（沙箱默认直连: https://api-m.sandbox.paypal.com，留空即可）
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com


# ------------------------------------------------------------------------------
# 📈 4. 网站访问统计（本地开发默认不注入，避免产生脏数据）
# ------------------------------------------------------------------------------
# GA_MEASUREMENT_ID=
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js


# ------------------------------------------------------------------------------
# 🤖 5. 飞书到账即时通知机器人 (选填，即插即用)
# ------------------------------------------------------------------------------
# 飞书群自定义机器人 Webhook 地址（在飞书群设置 -> 群机器人 -> 添加自定义机器人后获取）
# 留空则自动关闭推送；填入后每当有新订单支付成功，群内实时收到到账卡片通知。
# 示例：https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK_URL=
# 可选：自定义机器人的安全签名密钥
FEISHU_WEBHOOK_SECRET=

