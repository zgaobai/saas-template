# ==============================================================================
# 🚀 生产环境配置文件模版 (.env.production.example)
#
# 使用指南：
# 1. 复制本文件为 .env.production：
#    cp .env.production.example .env.production
# 2. 在 .env.production 中根据下方注释填入你的真实线上域名与商户凭据。
# 3. 运行 npm run deploy:production 即可自动读取、加密同步并一键发布到 Cloudflare！
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. 生产域名与 Cloudflare 资源绑定（必填）
# ------------------------------------------------------------------------------

# 【必填】站点的完整公网访问域名（必须是 https 协议，末尾严禁加斜杠 /）
# 示例：https://yourdomain.com 或 https://app.yourdomain.com
# 说明：此域名将作为身份认证回调、支付 Webhook 回跳、SEO Canonical 与 Sitemap 的唯一基准地址。
APP_URL=https://yourdomain.com

# 【必填】Cloudflare D1 边缘 SQLite 生产数据库 ID (UUID 格式)
# 获取方式：在终端执行 npx wrangler d1 create qihang-db-production 后，复制输出中的 database_id
# 示例：xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
D1_DATABASE_ID=

# 【选填】Cloudflare R2 私有对象存储桶名称（用于用户生成物与导出文件存储）
# 默认值：qihang-files-production（执行 npx wrangler r2 bucket create qihang-files-production 创建）
R2_BUCKET_NAME=qihang-files-production


# ------------------------------------------------------------------------------
# 🔐 2. 会话安全与管理员后台权限
# ------------------------------------------------------------------------------

# 【选填/自动补齐】Better Auth 用户会话 Cookie 签名加密密钥（至少 32 字符）
# 说明：用于保护登录态不被伪造。若留空，部署脚本会自动生成 48 位高强度安全随机串并写回本文件，无需手动折腾。
BETTER_AUTH_SECRET=

# 【选填/自动补齐】离线充值卡密与兑换码的高强度 AES-256-GCM 加密密钥（64 位十六进制字符）
# 说明：保护后台生成的卡密防伪防撞。若留空，部署脚本会自动生成 64 位 Hex 密钥并写回本文件。
REDEMPTION_ENCRYPTION_KEY=

# 【选填】管理员 User ID 授权列表（多个 ID 用英文半角逗号分隔，如：usr_123,usr_456）
# 说明：拥有此 ID 的用户登录后可直接访问 /admin 超管后台（运营大盘、用户管理、审计日志、兑换码生成等）。
# 建议：上线后先在网站前台注册一个普通账号，在个人中心 /account 复制该用户的 User ID 填入此处，
#       然后运行 npm run env:sync:production，即可秒级赋予其管理员权限。
ADMIN_USER_IDS=


# ------------------------------------------------------------------------------
# 📧 3. 事务性邮件服务 (Resend，生产环境必填)
# ------------------------------------------------------------------------------

# 【必填】Resend 邮件发送平台的 API Key
# 获取方式：登录 https://resend.com 在 API Keys 页面创建，以 re_ 开头
# 作用：用于发送新用户注册邮箱验证邮件、找回密码与安全通知
RESEND_API_KEY=

# 【必填】发信人邮箱地址（必须是已在 Resend 控制台 Domains 页面验证通过的域名）
# 示例：support@yourdomain.com 或 "MyBrand Support" <noreply@yourdomain.com>
EMAIL_FROM=support@yourdomain.com

# 【选填】Google OAuth 2.0 一键快捷登录凭据
# 获取方式：在 Google Cloud Console (https://console.cloud.google.com/) 创建 OAuth Client ID
# 重定向 URI 请配置为：https://你的线上域名/api/auth/callback/google
# 说明：留空则前台自动隐藏 Google 登录按钮，仅保留常规邮箱验证码登录。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# ------------------------------------------------------------------------------
# 💳 4. 商业支付集成（根据你使用的支付平台四选一即可）
# ------------------------------------------------------------------------------

# 【必填】前台默认启用的支付通道
# 可选值：pancake (默认，Waffo Pancake 聚合支付) / stripe / creem / paypal
PAYMENT_PROVIDER=pancake

# --- 渠道 A：Waffo Pancake 聚合支付 (出海独立开发者首选，支持支付宝/微信/国际卡) ---
# 获取方式：登录 https://waffo.ai 控制台
PANCAKE_MERCHANT_ID=
# 商户 RSA 签名私钥（PEM 格式，支持单行内用 \n 转义真实换行，服务端自动恢复，绝不外发）
PANCAKE_PRIVATE_KEY=
# 平台 Webhook 回调验签公钥（PEM 格式，在 Pancake 后台 Webhook 页面复制）
PANCAKE_WEBHOOK_PUBLIC_KEY=
# Pancake 店铺 ID
PANCAKE_STORE_ID=
# 可选覆盖端点（默认直连官方正式端点: https://api.waffo.ai，留空即可）
# PANCAKE_BASE_URL=https://api.waffo.ai

# --- 渠道 B：Stripe 信用卡与周期性订阅结算 (具备海外实体的团队常用) ---
# 获取方式：登录 https://dashboard.stripe.com 在 Developers -> API keys 复制 Secret Key (sk_live_...)
#           并在 Webhooks 页面配置端点 (https://你的域名/api/webhooks/stripe) 取得 Signing secret (whsec_...)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# 可选覆盖端点（默认直连官方: https://api.stripe.com，留空即可）
# STRIPE_BASE_URL=https://api.stripe.com

# --- 渠道 C：Creem 托管支付与数字订阅 (专门面向独立开发者的托管结算) ---
# 获取方式：登录 https://creem.io 后台获取 API Key 与 Webhook Secret
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# 可选覆盖端点（生产环境默认: https://api.creem.io，留空即可）
# CREEM_BASE_URL=https://api.creem.io

# --- 渠道 D：PayPal 全球电子钱包支付与订阅 ---
# 获取方式：登录 https://developer.paypal.com 创建 Live REST App 获得 Client ID 与 Secret，并在 Webhook 页面获取 Webhook ID
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# 可选覆盖端点（生产环境默认: https://api-m.paypal.com，留空即可）
# PAYPAL_BASE_URL=https://api-m.paypal.com


# ------------------------------------------------------------------------------
# 📈 5. 网站访问统计分析（可选，仅生产环境安全注入）
# ------------------------------------------------------------------------------

# 【选填】Google Analytics 4 衡量 ID
# 示例：G-XXXXXXXXXX
# 说明：仅在生产环境 HTTPS 且可被搜索引擎索引时自动注入，本地开发绝不产生脏数据。
# GA_MEASUREMENT_ID=

# 【选填】Umami 统计平台配置（轻量、注重用户隐私）
# 获取方式：在 Umami 控制台添加域名后获得的 Website ID (UUID 格式)
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
